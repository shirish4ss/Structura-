// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  role                UserRole         @default(USER)
  subscriptionTier    SubscriptionTier @default(FREE)
  isBanned            Boolean          @default(false)
  stripeCustomerId    String?          @unique
  razorpayCustomerId  String?          @unique
  subscriptionId      String?          @unique
  currentPeriodEnd    DateTime?
  billingCountry      String?          // e.g., "IN", "US"
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  sites               Site[]
}

model Site {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subdomain        String           @unique
  customDomain     String?          @unique
  themeSettings    Json?            // colors, fonts, etc.
  publishedTheme   Json?
  isPublished      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  pages            Page[]
  submissions      FormSubmission[]
}

model Page {
  id                String   @id @default(cuid())
  siteId            String
  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug              String   // e.g., "about"
  seoMetadata       Json?    // { title, description, ogImage }
  sections          Json     // Array of sections: [{ type: "hero", content: {} }, ...]
  publishedSections Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([siteId, slug])
}

model FormSubmission {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  formData  Json     // { name: "...", email: "...", message: "..." }
  status    String   @default("NEW") // NEW, READ, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
